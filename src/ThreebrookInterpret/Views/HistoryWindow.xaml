<Window x:Class="ThreebrookInterpret.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ThreebrookInterpret.Views"
        Title="{DynamicResource S.History.WindowTitle}" Width="464" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource F.Body}" FontSize="13" Foreground="{DynamicResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <v:ThumbnailConverter x:Key="Thumbnail"/>
        <v:RelativeTimeConverter x:Key="RelativeTime"/>
        <v:BoolToVisibilityConverter x:Key="Visible"/>
        <v:BoolToVisibilityConverter x:Key="Hidden" Invert="True"/>

        <ContextMenu x:Key="ItemMenu">
            <MenuItem Header="{DynamicResource S.History.Paste}" InputGestureText="Enter" Click="Paste_Click"/>
            <MenuItem Header="{DynamicResource S.History.CopyOnly}" InputGestureText="Ctrl+C" Click="Copy_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource S.Common.Translate}" Click="Translate_Click" Visibility="{Binding IsImage, Converter={StaticResource Hidden}}"/>
            <MenuItem Header="{DynamicResource S.Common.RecognizeText}" Click="Ocr_Click" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
            <MenuItem Header="{DynamicResource S.Common.RecognizeTranslate}" Click="OcrTranslate_Click" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
            <MenuItem Header="{DynamicResource S.Common.Pin}" Click="Pin_Click" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
            <MenuItem Header="{DynamicResource S.History.SaveImage}" Click="Save_Click" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
            <Separator/>
            <MenuItem Header="{DynamicResource S.Common.Delete}" InputGestureText="Delete" Click="Delete_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="{DynamicResource B.Bg}" CornerRadius="14" Effect="{DynamicResource WindowShadow}"/>
        <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="14">
            <DockPanel>
                <!-- 有名字的控件不能放进 TitleBar 的内容属性（UserControl 名称范围限制），叠放在标题栏右侧 -->
                <Grid DockPanel.Dock="Top">
                    <v:TitleBar Title="{DynamicResource S.Common.ClipboardHistory}" CloseToolTip="{DynamicResource S.Common.CloseEsc}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,48,0">
                        <Border Background="{DynamicResource B.Track}" CornerRadius="8" Padding="8,2" Margin="0,0,6,0" ToolTip="{DynamicResource S.History.Count}">
                            <TextBlock x:Name="CountText" Style="{StaticResource Text.Mono}" FontSize="11"/>
                        </Border>
                        <Button Style="{StaticResource Btn.Icon}" Content="{StaticResource I.Delete}" ToolTip="{DynamicResource S.Settings.ClearHistory}" Click="Clear_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 搜索框：左侧图标，右侧快捷键提示 -->
                <Grid DockPanel.Dock="Top" Margin="16,2,16,0">
                    <TextBox x:Name="SearchBox" Height="40" Padding="34,0,12,0" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.Search}" FontSize="18" Margin="11,0,0,0"
                               HorizontalAlignment="Left" Foreground="{DynamicResource B.TextMuted}" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource S.History.Search}" Margin="35,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource B.TextMuted}" IsHitTestVisible="False"/>
                </Grid>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,4">
                    <RadioButton x:Name="KindAll" Style="{StaticResource Segment}" Content="{DynamicResource S.History.All}" GroupName="Kind" IsChecked="True" Checked="Kind_Checked"/>
                    <RadioButton x:Name="KindText" Style="{StaticResource Segment}" GroupName="Kind" Checked="Kind_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.Notes}" FontSize="15" Margin="0,0,4,0"/>
                            <TextBlock Text="{DynamicResource S.History.Text}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="KindImage" Style="{StaticResource Segment}" GroupName="Kind" Checked="Kind_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.Image}" FontSize="15" Margin="0,0,4,0"/>
                            <TextBlock Text="{DynamicResource S.History.Images}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="16,6,16,12" FontSize="12" Foreground="{DynamicResource B.TextMuted}">
                    <Run Text="Enter" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.History.HintPaste}"/><Run
                         Text="Ctrl+C" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.History.HintCopy}"/><Run
                         Text="Delete" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.History.HintDelete}"/>
                </TextBlock>

                <Grid>
                    <ListBox x:Name="List" Padding="10,2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="List_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
                                <Setter Property="Margin" Value="6,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12,9">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.ChipBorder}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                               LineHeight="20" Foreground="{DynamicResource B.Text}"
                                               Visibility="{Binding IsImage, Converter={StaticResource Hidden}}"/>
                                    <Border CornerRadius="6" HorizontalAlignment="Left" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                            Visibility="{Binding IsImage, Converter={StaticResource Visible}}" ClipToBounds="True">
                                        <Image Source="{Binding Converter={StaticResource Thumbnail}}" MaxHeight="120" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource B.TextMuted}"
                                                   Text="{StaticResource I.Notes}" Margin="0,0,4,0"
                                                   Visibility="{Binding IsImage, Converter={StaticResource Hidden}}"/>
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource B.TextMuted}"
                                                   Text="{StaticResource I.Image}" Margin="0,0,4,0"
                                                   Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
                                        <TextBlock Text="{Binding Time, Converter={StaticResource RelativeTime}}" FontSize="11.5"
                                                   Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource Text.Mono}" FontSize="11" Margin="8,0,0,0"
                                                   Visibility="{Binding IsImage, Converter={StaticResource Visible}}">
                                            <Run Text="{Binding Width, Mode=OneWay}"/><Run Text="×"/><Run Text="{Binding Height, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空状态：图标 44 + 标题字体 -->
                    <StackPanel x:Name="EmptyText" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.Paste}" FontSize="44"
                                   Foreground="{DynamicResource B.TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource S.History.Empty}" FontFamily="{StaticResource F.DisplayZh}" FontSize="20" Margin="0,10,0,4"
                                   Foreground="{DynamicResource B.Text}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource S.History.EmptyHint}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
