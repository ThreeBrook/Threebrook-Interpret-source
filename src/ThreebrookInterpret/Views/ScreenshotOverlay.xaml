<Window x:Class="ThreebrookInterpret.Views.ScreenshotOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Shot.WindowTitle}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual" Background="Black" Cursor="Cross"
        FontFamily="{StaticResource F.Body}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        </Style>
        <Style x:Key="ToolIcon" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <!-- 标注工具按钮：选中时 accentSoft 底、accent 图标 -->
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        </Style>
        <Style x:Key="ToolIconButton" TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        </Style>
        <!-- 颜色、粗细选择：选中时外圈 accent -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource B.Accent}" StrokeThickness="2" Visibility="Hidden"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 正在输入的标注文字：透明底、虚线框 -->
        <Style x:Key="AnnotationText" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Rectangle Stroke="{TemplateBinding Foreground}" StrokeThickness="1" StrokeDashArray="3 2" Opacity="0.8"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="3,1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 尺寸、提示标签：品牌墨绿半透明底，在任何画面上都清楚 -->
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource B.Overlay}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Image x:Name="ScreenImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <Canvas x:Name="Layer" Background="Transparent">
            <Path x:Name="Mask" Fill="#80000000"/>
            <Canvas x:Name="Annotations" IsHitTestVisible="False"
                    Width="{Binding ActualWidth, ElementName=Layer}" Height="{Binding ActualHeight, ElementName=Layer}"/>
            <Rectangle x:Name="SelectionBorder" Stroke="{DynamicResource B.Brook}" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>

            <Border x:Name="SizeLabel" Style="{StaticResource Tag}" Padding="7,2" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontFamily="{StaticResource F.Mono}" FontSize="12"/>
            </Border>

            <Border x:Name="Hint" Style="{StaticResource Tag}" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.Screenshot}" Foreground="{DynamicResource B.Brook}" FontSize="17" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HintText" Foreground="White" FontSize="13" Text="{DynamicResource S.Shot.Hint}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="Toolbar" Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="4" Visibility="Collapsed" Cursor="Arrow" Effect="{DynamicResource WindowShadow}">
                <StackPanel>
                    <!-- 编辑组 + 操作组：选区够宽时一排，不够宽时分两排（见 LayoutToolbarRows） -->
                    <StackPanel x:Name="ToolbarRows" Orientation="Horizontal">
                    <StackPanel x:Name="EditGroup" Orientation="Horizontal">
                        <!-- 标注工具（数字键 1–8） -->
                        <StackPanel x:Name="ToolButtons" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolToggle}" Tag="Rect" Content="{StaticResource I.Rect}" ToolTip="{DynamicResource S.Shot.Rect}" Click="Tool_Click"/>
                            <ToggleButton Style="{StaticResource ToolToggle}" Tag="Ellipse" Content="{StaticResource I.Ellipse}" ToolTip="{DynamicResource S.Shot.Ellipse}" Click="Tool_Click"/>
                            <ToggleButton Style="{StaticResource ToolToggle}" Tag="Arrow" Content="{StaticResource I.Arrow}" ToolTip="{DynamicResource S.Shot.Arrow}" Click="Tool_Click"/>
                            <ToggleButton Style="{StaticResource ToolToggle}" Tag="Pen" Content="{StaticResource I.Pen}" ToolTip="{DynamicResource S.Shot.Pen}" Click="Tool_Click"/>
                            <ToggleButton Style="{StaticResource ToolToggle}" Tag="Highlighter" Content="{StaticResource I.Highlighter}" ToolTip="{DynamicResource S.Shot.Highlighter}" Click="Tool_Click"/>
                            <ToggleButton Style="{StaticResource ToolToggle}" Tag="Text" Content="{StaticResource I.Text}" ToolTip="{DynamicResource S.Shot.Text}" Click="Tool_Click"/>
                            <ToggleButton Style="{StaticResource ToolToggle}" Tag="Mosaic" Content="{StaticResource I.Mosaic}" ToolTip="{DynamicResource S.Shot.Mosaic}" Click="Tool_Click"/>
                            <ToggleButton Style="{StaticResource ToolToggle}" Tag="Number" Content="{StaticResource I.Number}" ToolTip="{DynamicResource S.Shot.Number}" Click="Tool_Click"/>
                        </StackPanel>
                        <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource B.Border}"/>
                        <Button Style="{StaticResource ToolIconButton}" Content="{StaticResource I.Undo}" ToolTip="{DynamicResource S.Shot.Undo}" Click="Undo_Click"/>
                        <Button Style="{StaticResource ToolIconButton}" Content="{StaticResource I.Redo}" ToolTip="{DynamicResource S.Shot.Redo}" Click="Redo_Click"/>
                    </StackPanel>
                    <Rectangle x:Name="GroupSeparator" Width="1" Margin="4,8" Fill="{DynamicResource B.Border}"/>
                    <StackPanel x:Name="ActionGroup" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ToolIconButton}" Content="{StaticResource I.Ocr}" ToolTip="{DynamicResource S.Shot.Ocr}" Click="Ocr_Click"/>
                        <Button Style="{StaticResource ToolButton}" Click="Translate_Click" ToolTip="{DynamicResource S.Shot.OcrTranslate}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolIcon}" Text="{StaticResource I.Translate}"/><TextBlock Text="{DynamicResource S.Common.Translate}" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Rectangle Width="1" Margin="4,8" Fill="{DynamicResource B.Border}"/>
                        <Button Style="{StaticResource ToolIconButton}" Content="{StaticResource I.LongShot}" ToolTip="{DynamicResource S.Shot.Long}" Click="LongShot_Click"/>
                        <Button Style="{StaticResource ToolIconButton}" Content="{StaticResource I.Pin}" ToolTip="{DynamicResource S.Shot.Pin}" Click="Pin_Click"/>
                        <Button Style="{StaticResource ToolIconButton}" Content="{StaticResource I.Save}" ToolTip="{DynamicResource S.Shot.Save}" Click="Save_Click"/>
                        <Button Style="{StaticResource ToolButton}" Click="Copy_Click" ToolTip="{DynamicResource S.Shot.Copy}" Foreground="{DynamicResource B.Accent}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource ToolIcon}" Text="{StaticResource I.Copy}"/><TextBlock Text="{DynamicResource S.Common.Copy}" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolIconButton}" Content="{StaticResource I.Close}" ToolTip="{DynamicResource S.Common.CancelEsc}" Click="Cancel_Click" Foreground="{DynamicResource B.TextSub}"/>
                    </StackPanel>
                    </StackPanel>

                    <!-- 选中工具后出现：粗细 + 颜色（颜色按钮在代码里生成） -->
                    <StackPanel x:Name="PropertyBar" Orientation="Horizontal" Margin="4,2,4,2" Visibility="Collapsed">
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Size" Tag="0" ToolTip="{DynamicResource S.Shot.Thin}" Checked="Size_Checked">
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource B.Text}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Size" Tag="1" ToolTip="{DynamicResource S.Shot.Medium}" IsChecked="True" Checked="Size_Checked">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource B.Text}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource Swatch}" GroupName="Size" Tag="2" ToolTip="{DynamicResource S.Shot.Thick}" Checked="Size_Checked">
                            <Ellipse Width="14" Height="14" Fill="{DynamicResource B.Text}"/>
                        </RadioButton>
                        <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource B.Border}"/>
                        <StackPanel x:Name="ColorButtons" Orientation="Horizontal"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
