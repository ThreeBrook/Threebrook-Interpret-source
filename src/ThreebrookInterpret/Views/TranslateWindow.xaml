<Window x:Class="ThreebrookInterpret.Views.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ThreebrookInterpret.Views"
        Title="{DynamicResource S.App.Name}" Width="524" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource F.Body}" FontSize="13" Foreground="{DynamicResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <v:RelativeTimeConverter x:Key="RelativeTime"/>
        <ContextMenu x:Key="RecordMenu">
            <MenuItem Header="{DynamicResource S.TransHistory.Open}" InputGestureText="Enter" Click="OpenRecord_Click"/>
            <MenuItem Header="{DynamicResource S.TransHistory.CopyResult}" InputGestureText="Ctrl+C" Click="CopyRecord_Click"/>
            <Separator/>
            <MenuItem Header="{DynamicResource S.Common.Delete}" InputGestureText="Delete" Click="DeleteRecord_Click"/>
        </ContextMenu>
    </Window.Resources>

    <!-- 外层留 12 像素给窗口阴影；阴影层与内容层分开，避免文字被效果渲染成位图 -->
    <Grid Margin="12">
        <Border Background="{DynamicResource B.Bg}" CornerRadius="14" Effect="{DynamicResource WindowShadow}"/>
        <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="14">
            <DockPanel>
                <!-- 有名字的控件不能放进 TitleBar 的内容属性（UserControl 名称范围限制），叠放在标题栏右侧 -->
                <Grid DockPanel.Dock="Top">
                    <v:TitleBar Title="{DynamicResource S.App.Name}" CloseToolTip="{DynamicResource S.Translate.HideEsc}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,48,0">
                        <ComboBox x:Name="TargetBox" Width="140" Height="28" FontSize="12.5" Margin="0,0,4,0"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Code" ToolTip="{DynamicResource S.Translate.Target}"
                                  SelectionChanged="TargetBox_SelectionChanged"/>
                        <ToggleButton x:Name="HistoryButton" Style="{StaticResource Btn.Icon}" Content="{StaticResource I.History}"
                                      ToolTip="{DynamicResource S.TransHistory.Title}" Checked="HistoryButton_Changed" Unchecked="HistoryButton_Changed"/>
                        <ToggleButton x:Name="PinButton" Style="{StaticResource Btn.Icon}" Content="{StaticResource I.Pin}"
                                      ToolTip="{DynamicResource S.Translate.Pin}"/>
                    </StackPanel>
                </Grid>

                <!-- 翻译历史：点标题栏的历史按钮，和下面的翻译区互换 -->
                <DockPanel x:Name="HistoryPanel" DockPanel.Dock="Top" Height="470" Margin="16,2,16,14" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="HistorySearch" Height="38" Padding="34,0,12,0" TextChanged="HistorySearch_TextChanged"/>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.Search}" FontSize="18" Margin="11,0,0,0"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource B.TextMuted}" IsHitTestVisible="False"/>
                        <TextBlock x:Name="HistoryPlaceholder" Text="{DynamicResource S.TransHistory.Search}" Margin="35,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource B.TextMuted}" IsHitTestVisible="False"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" Content="{StaticResource I.Delete}" Margin="6,0,0,0"
                                ToolTip="{DynamicResource S.TransHistory.Clear}" Click="ClearHistory_Click"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0" FontSize="12" Foreground="{DynamicResource B.TextMuted}">
                        <Run Text="Enter" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.TransHistory.HintOpen}"/><Run
                             Text="Ctrl+C" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.TransHistory.HintCopy}"/><Run
                             Text="Esc" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.TransHistory.HintBack}"/><Run
                             Text="Delete" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.History.HintDelete}"/>
                    </TextBlock>
                    <Grid Margin="0,8,0,0">
                        <ListBox x:Name="HistoryList" Margin="-6,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="HistoryList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="ContextMenu" Value="{StaticResource RecordMenu}"/>
                                    <Setter Property="Margin" Value="6,4"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}"
                                                        BorderThickness="1" CornerRadius="10" Padding="12,9">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.ChipBorder}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                                   LineHeight="20" Foreground="{DynamicResource B.Text}"/>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                                   LineHeight="20" Margin="0,4,0,0" Foreground="{DynamicResource B.TextSub}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Time, Converter={StaticResource RelativeTime}}" FontSize="11.5"
                                                       Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock FontSize="11.5" Margin="8,0,0,0" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center">
                                                <Run Text="→ "/><Run Text="{Binding TargetName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态：图标 44 + 标题字体 -->
                        <StackPanel x:Name="HistoryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.History}" FontSize="44"
                                       Foreground="{DynamicResource B.TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.TransHistory.Empty}" FontFamily="{StaticResource F.DisplayZh}" FontSize="20" Margin="0,10,0,4"
                                       Foreground="{DynamicResource B.Text}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="HistoryEmptyHint" Text="{DynamicResource S.TransHistory.EmptyHint}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <StackPanel x:Name="TranslatePanel" Margin="16,2,16,16">
                    <Grid>
                        <TextBox x:Name="InputBox" MinHeight="84" MaxHeight="220" Padding="12,10" FontSize="14"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"/>
                        <TextBlock x:Name="Placeholder" Text="{DynamicResource S.Translate.Placeholder}" Margin="15,11,0,0" FontSize="14"
                                   Foreground="{DynamicResource B.TextMuted}" IsHitTestVisible="False"/>
                    </Grid>

                    <DockPanel Margin="2,8,0,0">
                        <Border x:Name="DirectionChip" DockPanel.Dock="Right" Background="{DynamicResource B.AccentSoft}"
                                CornerRadius="6" Padding="8,2" Visibility="Collapsed">
                            <TextBlock x:Name="DirectionText" FontSize="12" Foreground="{DynamicResource B.Accent}"/>
                        </Border>
                        <TextBlock FontSize="12" Foreground="{DynamicResource B.TextMuted}" VerticalAlignment="Center">
                            <Run Text="Enter" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.Translate.HintTranslate}"/><Run
                                 Text="Shift+Enter" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.Translate.HintNewline}"/><Run
                                 Text="Esc" FontFamily="{StaticResource F.Mono}"/><Run Text="{DynamicResource S.Translate.HintHide}"/>
                        </TextBlock>
                    </DockPanel>

                    <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl x:Name="ResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Margin="0,8,0,0" Padding="14,10,8,12" CornerRadius="10"
                                            Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}"
                                                        Click="Copy_Click" Visibility="Collapsed" ToolTip="{DynamicResource S.Translate.CopyResult}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="15" Text="{StaticResource I.Copy}"/>
                                                        <TextBlock Text="{DynamicResource S.Common.Copy}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource B.TextSub}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Mono}" FontSize="11" Margin="8,0,0,0"/>
                                            </DockPanel>
                                            <TextBox x:Name="ResultText" Style="{StaticResource Text.Selectable}" Margin="0,6,4,0"
                                                     Text="{Binding Text, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasResult}" Value="True">
                                            <Setter TargetName="CopyButton" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="ResultText" Property="Foreground" Value="{DynamicResource B.Danger}"/>
                                            <Setter TargetName="ResultText" Property="FontSize" Value="12.5"/>
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource B.DangerBg}"/>
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource B.DangerBorder}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
