<!--
  安装 / 卸载向导（参考三溪寻影安装程序的版式）：左侧栏是产品图标、名称、随页面变化的提示卡片和步骤，
  右侧是大标题 + 说明 + 页面内容，底部操作条。所有页面都在这里，代码里切换显示。
-->
<Window x:Class="ThreebrookInterpret.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ThreebrookInterpret.Views"
        Title="安装 三溪通译" Width="784" Height="544"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/ThreebrookInterpret;component/Assets/AppIcon.ico"
        FontFamily="{StaticResource F.Body}" FontSize="13" Foreground="{DynamicResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Page" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="FeatureIcon" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource B.AccentSoft}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        <Style x:Key="FeatureGlyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FeatureTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="FeatureSub" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <!-- 页面底部操作条：上边一条分隔线 -->
        <Style x:Key="ActionBar" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="32,14,24,16"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style x:Key="BarButtons" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="{DynamicResource B.Bg}" CornerRadius="14" Effect="{DynamicResource WindowShadow}"/>
        <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2" Background="{DynamicResource B.Sidebar}" CornerRadius="13,0,0,13"/>
                <Border Grid.RowSpan="2" Width="1" HorizontalAlignment="Right" Background="{DynamicResource B.Border}"/>
                <v:TitleBar x:Name="Bar" Grid.ColumnSpan="2" Title="安装 三溪通译" ShowMinimize="True"/>

                <!-- ========== 侧栏 ========== -->
                <DockPanel Grid.Row="1" Margin="22,12,22,18">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.Lock}" FontSize="15"
                                   Foreground="{DynamicResource B.TextMuted}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="FooterText" Style="{StaticResource Text.Caption}" Text="{DynamicResource S.Setup.FooterInstall}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <Image Source="pack://application:,,,/ThreebrookInterpret;component/Assets/AppIcon-128.png" Width="72" Height="72"
                               HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="ProductNameText" Text="三溪通译" TextWrapping="Wrap" FontFamily="{DynamicResource F.Title}" FontWeight="{DynamicResource F.TitleWeight}" FontSize="22" Margin="0,14,0,0"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Text.Mono}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                   Text="Threebrook Interpret 0.7.0"/>
                        <Border Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                CornerRadius="12" Padding="14,12" Margin="0,20,0,0">
                            <TextBlock x:Name="TipText" TextWrapping="Wrap" LineHeight="21" FontSize="12.5" Foreground="{DynamicResource B.TextSub}"/>
                        </Border>
                        <StackPanel x:Name="StepsPanel" Margin="2,22,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- ========== 右侧 ========== -->
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="32,14,32,0">
                        <TextBlock x:Name="HeadingText" Style="{StaticResource Text.TitleZh}" FontSize="30" Text="欢迎安装三溪通译"/>
                        <TextBlock x:Name="DescText" Style="{StaticResource Text.Caption}" FontSize="13.5" Foreground="{DynamicResource B.TextSub}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- 欢迎 -->
                        <Grid x:Name="WelcomePage" Style="{StaticResource Page}">
                            <StackPanel Margin="32,26,32,0">
                                <DockPanel Margin="0,0,0,18">
                                    <Border Style="{StaticResource FeatureIcon}"><TextBlock Style="{StaticResource FeatureGlyph}" Text="{StaticResource I.Translate}"/></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FeatureTitle}" Text="{DynamicResource S.Setup.Feature1}"/>
                                        <TextBlock x:Name="HotkeyFeatureText" Style="{StaticResource FeatureSub}" Text="Alt+D 划词 · Alt+Q 输入 · Alt+W 截图翻译"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <Border Style="{StaticResource FeatureIcon}"><TextBlock Style="{StaticResource FeatureGlyph}" Text="{StaticResource I.Screenshot}"/></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FeatureTitle}" Text="{DynamicResource S.Setup.Feature2}"/>
                                        <TextBlock x:Name="OcrFeatureText" Style="{StaticResource FeatureSub}" Text="{DynamicResource S.Setup.Feature2Sub}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource FeatureIcon}"><TextBlock Style="{StaticResource FeatureGlyph}" Text="{StaticResource I.Sparkle}"/></Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FeatureTitle}" Text="{DynamicResource S.Setup.Feature3}"/>
                                        <TextBlock Style="{StaticResource FeatureSub}" Text="{DynamicResource S.Setup.Feature3Sub}"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{DynamicResource S.Setup.AgreePrefix}"/>
                                    <Button Style="{StaticResource Link}" Content="{DynamicResource S.Setup.LicenseLink}" FontSize="12.5" Click="License_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource ActionBar}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Padding="32,0" Content="{DynamicResource S.Setup.Install}" Click="Install_Click" IsDefault="True"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="WelcomePathText" Style="{StaticResource Text.Mono}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock x:Name="WelcomeSizeText" Style="{StaticResource Text.Caption}" Text="需要 1 MB · "/>
                                            <Button Style="{StaticResource Link}" Content="{DynamicResource S.Setup.ChangeOptions}" FontSize="12.5" Click="Options_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- 位置和选项 -->
                        <Grid x:Name="OptionsPage" Style="{StaticResource Page}">
                            <StackPanel Margin="32,26,32,0">
                                <TextBlock Style="{StaticResource Text.Body}" Text="{DynamicResource S.Setup.InstallTo}" Foreground="{DynamicResource B.TextSub}" Margin="0,0,0,8"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Outline}" Content="{DynamicResource S.Setup.Browse}" Margin="8,0,0,0" Click="Browse_Click"/>
                                    <TextBox x:Name="DirBox" FontFamily="{StaticResource F.Mono}" FontSize="12" VerticalContentAlignment="Center"
                                             TextChanged="DirBox_TextChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="SpaceText" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                                <CheckBox x:Name="DesktopBox" Content="{DynamicResource S.Setup.DesktopShortcut}" Margin="0,22,0,0" IsChecked="True"/>
                                <CheckBox x:Name="AutoStartBox" Content="{DynamicResource S.Setup.AutoStart}" Margin="0,14,0,0" IsChecked="True"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,22,0,0" LineHeight="20"
                                           Text="{DynamicResource S.Setup.OptionsNote}"/>
                            </StackPanel>
                            <Border Style="{StaticResource ActionBar}">
                                <StackPanel Style="{StaticResource BarButtons}">
                                    <Button Style="{StaticResource Btn.Outline}" Content="{DynamicResource S.Setup.Back}" Padding="20,0" Margin="0,0,10,0" Click="Back_Click" IsCancel="True"/>
                                    <Button Style="{StaticResource Btn.Primary}" Padding="32,0" Content="{DynamicResource S.Setup.Install}" Click="Install_Click" IsDefault="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 许可协议 -->
                        <Grid x:Name="LicensePage" Style="{StaticResource Page}">
                            <Border Margin="32,22,32,84" Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}"
                                    BorderThickness="1" CornerRadius="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                                    <TextBlock x:Name="LicenseText" TextWrapping="Wrap" LineHeight="21" FontSize="12.5" Foreground="{DynamicResource B.TextSub}"/>
                                </ScrollViewer>
                            </Border>
                            <Border Style="{StaticResource ActionBar}">
                                <StackPanel Style="{StaticResource BarButtons}">
                                    <Button Style="{StaticResource Btn.Outline}" Content="{DynamicResource S.Setup.Back}" Padding="20,0" Click="Back_Click" IsCancel="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 安装中 / 卸载中 -->
                        <Grid x:Name="ProgressPage" Style="{StaticResource Page}">
                            <StackPanel Margin="32,22,32,0">
                                <TextBlock x:Name="PercentText" FontFamily="{StaticResource F.DisplayEn}" FontWeight="Bold" FontSize="52"
                                           Foreground="{DynamicResource B.Accent}" Text="0 %"/>
                                <Grid x:Name="ProgressTrack" Height="8" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource B.Track}" CornerRadius="4"/>
                                    <Border x:Name="ProgressFill" Background="{DynamicResource B.Accent}" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="FileText" Style="{StaticResource Text.Mono}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Border x:Name="ProgressTip" Background="{DynamicResource B.Highlight}" BorderBrush="{DynamicResource B.HighlightBorder}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,26,0,0">
                                    <TextBlock x:Name="ProgressTipText" TextWrapping="Wrap" LineHeight="20" FontSize="12.5" Foreground="{DynamicResource B.SunInk}"/>
                                </Border>
                            </StackPanel>
                            <Border Style="{StaticResource ActionBar}">
                                <StackPanel Style="{StaticResource BarButtons}">
                                    <Button x:Name="AbortButton" Style="{StaticResource Btn.Outline}" Content="{DynamicResource S.Setup.Abort}" Padding="20,0" Click="Abort_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 装好了 -->
                        <Grid x:Name="DonePage" Style="{StaticResource Page}">
                            <StackPanel Margin="32,22,32,0">
                                <Border Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                                        CornerRadius="12" Padding="18,12">
                                    <ItemsControl x:Name="HotkeyList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,5">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Mono}" FontSize="12.5"
                                                               Foreground="{DynamicResource B.TextSub}" Text="{Binding Value}"/>
                                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Key}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <CheckBox x:Name="LaunchBox" Content="{DynamicResource S.Setup.LaunchNow}" Margin="0,22,0,0" IsChecked="True"/>
                            </StackPanel>
                            <Border Style="{StaticResource ActionBar}">
                                <StackPanel Style="{StaticResource BarButtons}">
                                    <Button Style="{StaticResource Btn.Primary}" Padding="32,0" Content="{DynamicResource S.Setup.Finish}" Click="Finish_Click" IsDefault="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 出错 -->
                        <Grid x:Name="ErrorPage" Style="{StaticResource Page}">
                            <Border Margin="32,26,32,0" VerticalAlignment="Top" Background="{DynamicResource B.DangerBg}"
                                    BorderBrush="{DynamicResource B.DangerBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.Error}" FontSize="20" VerticalAlignment="Top"
                                               Foreground="{DynamicResource B.Danger}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource B.Danger}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource ActionBar}">
                                <StackPanel Style="{StaticResource BarButtons}">
                                    <Button Style="{StaticResource Btn.Outline}" Content="{DynamicResource S.Common.Close}" Padding="20,0" Margin="0,0,10,0" Click="Close_Click"/>
                                    <Button Style="{StaticResource Btn.Primary}" Padding="32,0" Content="{DynamicResource S.Setup.Retry}" Click="Retry_Click" IsDefault="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 已取消 -->
                        <Grid x:Name="CancelledPage" Style="{StaticResource Page}">
                            <Border Style="{StaticResource ActionBar}">
                                <StackPanel Style="{StaticResource BarButtons}">
                                    <Button Style="{StaticResource Btn.Outline}" Content="{DynamicResource S.Common.Close}" Padding="20,0" Margin="0,0,10,0" Click="Close_Click"/>
                                    <Button Style="{StaticResource Btn.Primary}" Padding="24,0" Content="{DynamicResource S.Setup.Reinstall}" Click="Restart_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 卸载确认 -->
                        <Grid x:Name="ConfirmPage" Style="{StaticResource Page}">
                            <StackPanel Margin="32,26,32,0">
                                <TextBlock Style="{StaticResource Text.Body}" Text="{DynamicResource S.Setup.Location}" Foreground="{DynamicResource B.TextSub}" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource B.Card}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                    <TextBlock x:Name="UninstallDirText" Style="{StaticResource Text.Mono}" FontSize="12" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource B.TextSub}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <CheckBox x:Name="DeleteDataBox" Content="{DynamicResource S.Setup.DeleteData}" Margin="0,24,0,0"/>
                                <TextBlock x:Name="DataDirText" Style="{StaticResource Text.Caption}" Margin="26,6,0,0"/>
                            </StackPanel>
                            <Border Style="{StaticResource ActionBar}">
                                <StackPanel Style="{StaticResource BarButtons}">
                                    <Button Style="{StaticResource Btn.Outline}" Content="{DynamicResource S.Common.Cancel}" Padding="20,0" Margin="0,0,10,0" Click="Close_Click" IsCancel="True"/>
                                    <Button Style="{StaticResource Btn.Danger}" Height="40" Padding="28,0" Click="Uninstall_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="{StaticResource I.DeleteForever}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource S.Setup.Uninstall}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 卸载好了 -->
                        <Grid x:Name="UninstalledPage" Style="{StaticResource Page}">
                            <Border Style="{StaticResource ActionBar}">
                                <StackPanel Style="{StaticResource BarButtons}">
                                    <Button Style="{StaticResource Btn.Primary}" Padding="32,0" Content="{DynamicResource S.Setup.Finish}" Click="Close_Click" IsDefault="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
