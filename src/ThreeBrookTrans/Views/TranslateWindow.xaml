<Window x:Class="ThreeBrookTrans.Views.TranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThreeBrook Trans" Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#FFFFFF" BorderBrush="#C8D1DA" BorderThickness="1"
        FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">


    <DockPanel>
        <!-- 标题栏：可拖动 -->
        <Grid DockPanel.Dock="Top" Height="38" Background="#F6F8FA" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ThreeBrook Trans" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#24292F"/>
            <ComboBox x:Name="TargetBox" Grid.Column="1" Width="140" Margin="0,0,6,0" VerticalAlignment="Center"
                      DisplayMemberPath="Name" SelectedValuePath="Code" FontSize="13"
                      ToolTip="目标语言" SelectionChanged="TargetBox_SelectionChanged"/>
            <ToggleButton x:Name="PinButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE718;"
                          ToolTip="固定窗口（失去焦点时不隐藏）"/>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8BB;" Margin="0,0,6,0"
                    ToolTip="隐藏（Esc）" Click="Hide_Click"/>
        </Grid>

        <StackPanel Margin="12,10,12,12">
            <Grid>
                <TextBox x:Name="InputBox" MinHeight="72" MaxHeight="200" Padding="6,5"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         BorderBrush="#C8D1DA" PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"/>
                <TextBlock x:Name="Placeholder" Text="输入要翻译的文字…" Margin="9,6" Foreground="#8C959F" IsHitTestVisible="False"/>
            </Grid>
            <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="DirectionText" DockPanel.Dock="Right" FontSize="12" Foreground="#1F6FEB"/>
                <TextBlock Text="Enter 翻译 · Shift+Enter 换行 · Esc 隐藏" FontSize="12" Foreground="#8C959F"/>
            </DockPanel>

            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="6" Background="#F6F8FA">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                                Padding="6,1" FontSize="12" Content="复制" Click="Copy_Click" Visibility="Collapsed"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#57606A" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#8C959F" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBox x:Name="ResultText" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             BorderThickness="0" Background="Transparent" Padding="0" Margin="0,4,0,0" Foreground="#24292F"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter TargetName="CopyButton" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="ResultText" Property="Foreground" Value="#CF222E"/>
                                    <Setter TargetName="ResultText" Property="FontSize" Value="12"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
