<Window x:Class="ThreeBrookTrans.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThreeBrookTrans.Views"
        Title="ThreeBrook Trans 剪贴板历史" Width="440" Height="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="#FFFFFF" BorderBrush="#C8D1DA" BorderThickness="1"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <local:ThumbnailConverter x:Key="Thumbnail"/>
        <local:RelativeTimeConverter x:Key="RelativeTime"/>
        <local:BoolToVisibilityConverter x:Key="Visible"/>
        <local:BoolToVisibilityConverter x:Key="Hidden" Invert="True"/>

        <ContextMenu x:Key="ItemMenu">
            <MenuItem Header="粘贴" InputGestureText="Enter" Click="Paste_Click"/>
            <MenuItem Header="仅复制" InputGestureText="Ctrl+C" Click="Copy_Click"/>
            <Separator/>
            <MenuItem Header="翻译" Click="Translate_Click" Visibility="{Binding IsImage, Converter={StaticResource Hidden}}"/>
            <MenuItem Header="识别文字" Click="Ocr_Click" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
            <MenuItem Header="识别并翻译" Click="OcrTranslate_Click" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
            <MenuItem Header="钉在桌面" Click="Pin_Click" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
            <MenuItem Header="保存图片…" Click="Save_Click" Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
            <Separator/>
            <MenuItem Header="删除" InputGestureText="Delete" Click="Delete_Click"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="38" Background="#F6F8FA" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="剪贴板历史" FontWeight="SemiBold" Foreground="#24292F" FontSize="14"/>
                <TextBlock x:Name="CountText" Margin="8,0,0,0" Foreground="#8C959F" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="清空历史" Click="Clear_Click"/>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;" Margin="0,0,6,0" ToolTip="关闭（Esc）" Click="Hide_Click"/>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Padding="6,4" BorderBrush="#C8D1DA" TextChanged="SearchBox_TextChanged"/>
            <TextBlock x:Name="SearchPlaceholder" Text="搜索文字…" Margin="9,5" Foreground="#8C959F" IsHitTestVisible="False"/>
            <ComboBox x:Name="KindBox" Grid.Column="1" Width="72" Margin="6,0,0,0" SelectedIndex="0" SelectionChanged="KindBox_SelectionChanged">
                <ComboBoxItem Content="全部"/>
                <ComboBoxItem Content="文字"/>
                <ComboBoxItem Content="图片"/>
            </ComboBox>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Margin="10,4,10,6" FontSize="12" Foreground="#8C959F"
                   Text="Enter / 双击 粘贴 · Ctrl+C 仅复制 · Delete 删除 · 右键更多"/>

        <Grid>
            <ListBox x:Name="List" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="List_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="8,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="#F6F8FA" CornerRadius="6" Padding="10,7" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EEF2F6"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DDEBFF"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1F6FEB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"
                                       Foreground="#24292F" Visibility="{Binding IsImage, Converter={StaticResource Hidden}}"/>
                            <Image Source="{Binding Converter={StaticResource Thumbnail}}" MaxHeight="110" Stretch="Uniform"
                                   HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IsImage, Converter={StaticResource Visible}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Time, Converter={StaticResource RelativeTime}}" FontSize="11" Foreground="#8C959F"/>
                                <TextBlock FontSize="11" Foreground="#8C959F" Margin="8,0,0,0" Visibility="{Binding IsImage, Converter={StaticResource Visible}}">
                                    <Run Text="{Binding Width, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding Height, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="还没有记录。复制文字或图片后会出现在这里。" Foreground="#8C959F"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
