<Window x:Class="ThreeBrookTrans.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThreeBrook Trans 设置" Width="680" Height="560" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#24292F"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C959F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#C8D1DA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="64"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" IsDefault="True" Click="Save_Click"/>
            <Button Content="取消" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>

        <TabControl>
            <!-- 常规 -->
            <TabItem Header="常规">
                <StackPanel Margin="16">
                    <CheckBox x:Name="AutoStartBox" Content="开机自动启动"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="默认目标语言" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="TargetBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding TargetLanguage}"/>
                    </Grid>
                    <CheckBox Content="划词、截图识别的文字自动合并句中换行（适合 PDF）" IsChecked="{Binding MergeLineBreaks}"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,16,0,4" Text="数据目录（配置、剪贴板历史、错误日志）："/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="打开" Margin="8,0,0,0" Click="OpenDataFolder_Click"/>
                        <TextBox x:Name="DataDirBox" IsReadOnly="True" Foreground="#57606A"/>
                    </DockPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Note}" Margin="0,16,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- 快捷键 -->
            <TabItem Header="快捷键">
                <StackPanel Margin="16" DataContext="{Binding Hotkeys}">
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                               Text="点击输入框后直接按下新的组合键；Backspace 清除（清除后该功能不注册快捷键）。"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <TextBlock Text="输入翻译" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Text="{Binding InputTranslate}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <TextBlock Text="划词翻译" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectionTranslate}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <TextBlock Text="截图" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Text="{Binding Screenshot}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <TextBlock Text="截图翻译" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Text="{Binding ScreenshotTranslate}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <TextBlock Text="剪贴板历史" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Text="{Binding History}" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- 翻译引擎 -->
            <TabItem Header="翻译引擎">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="AddEngineButton" Content="添加" MinWidth="0" Padding="8,3" Click="AddEngine_Click"/>
                            <Button Content="删除" MinWidth="0" Padding="8,3" Margin="4,0,0,0" Click="RemoveEngine_Click"/>
                            <Button Content="↑" MinWidth="0" Padding="8,3" Margin="4,0,0,0" ToolTip="上移" Click="MoveUp_Click"/>
                            <Button Content="↓" MinWidth="0" Padding="8,3" Margin="4,0,0,0" ToolTip="下移" Click="MoveDown_Click"/>
                        </StackPanel>
                        <ListBox x:Name="EnginesList" SelectionChanged="EnginesList_SelectionChanged" BorderBrush="#C8D1DA">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Name}" Margin="2" ToolTip="勾选表示启用"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="EngineDetail">
                            <TextBlock x:Name="EngineTypeText" FontWeight="SemiBold" Foreground="#24292F"/>
                            <TextBlock x:Name="EngineHelpText" Style="{StaticResource Note}" Margin="0,4,0,8"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="显示名称" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" LostFocus="EngineName_LostFocus"/>
                            </Grid>
                            <Grid x:Name="AppIdRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="AppIdLabel" Text="AppId" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid x:Name="SecretKeyRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="密钥" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding SecretKey, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid x:Name="BaseUrlRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="接口地址" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 http://localhost:11434/v1"/>
                            </Grid>
                            <Grid x:Name="ApiKeyRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid x:Name="RegionRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="区域" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" ToolTip="腾讯默认 ap-guangzhou；Azure 填资源所在区域，如 eastasia"/>
                            </Grid>
                            <Grid x:Name="ModelRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="模型名" Style="{StaticResource Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 qwen3:8b、deepseek-chat"/>
                            </Grid>
                            <StackPanel x:Name="LlmRows">
                                <CheckBox Content="关闭思考模式（Qwen3 等推理模型，翻译更快）" IsChecked="{Binding DisableThinking}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="超时（秒）" Style="{StaticResource Label}"/>
                                    <TextBox Grid.Column="1" Text="{Binding TimeoutSeconds}"/>
                                </Grid>
                                <TextBlock Text="自定义提示词（可选，{target} 会替换为目标语言）" Style="{StaticResource Note}" Margin="0,6,0,4"/>
                                <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="70" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="测试翻译" Click="TestEngine_Click"/>
                                <TextBlock x:Name="TestResultText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 截图与 OCR -->
            <TabItem Header="截图与识别">
                <StackPanel Margin="16" DataContext="{Binding Screenshot}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="保存目录" Style="{StaticResource Label}"/>
                        <TextBox x:Name="SaveDirBox" Grid.Column="1" Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="浏览…" Margin="8,0,0,0" Click="BrowseSaveDir_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Note}" Text="留空则保存到 图片\ThreeBrookTrans" Margin="110,0,0,0"/>
                    <CheckBox Content="保存时弹出“另存为”对话框（不勾选则直接保存到上面的目录）" IsChecked="{Binding AskSavePath}" Margin="0,10,0,5"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <TextBlock Text="图片格式" Style="{StaticResource Label}"/>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding ImageFormat}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="PNG" Tag="png"/>
                            <ComboBoxItem Content="JPG" Tag="jpg"/>
                        </ComboBox>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBlock Text="文字识别语言" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="OcrLanguageBox" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="Tag"
                                  SelectedValue="{Binding OcrLanguage}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Note}" Margin="110,2,0,0"
                               Text="使用 Windows 自带 OCR。识别日语、韩语、泰语等需要在 Windows 设置 → 时间和语言 → 语言 中添加该语言（含“光学字符识别”），之后会出现在列表里。"/>
                </StackPanel>
            </TabItem>

            <!-- 剪贴板历史 -->
            <TabItem Header="剪贴板历史">
                <StackPanel Margin="16" DataContext="{Binding History}">
                    <CheckBox Content="记录剪贴板历史" IsChecked="{Binding Enabled}"/>
                    <CheckBox Content="记录文字" IsChecked="{Binding RecordText}" Margin="20,5,0,5"/>
                    <CheckBox Content="记录图片" IsChecked="{Binding RecordImages}" Margin="20,5,0,5"/>
                    <CheckBox Content="在历史窗口按 Enter / 双击时，自动粘贴到之前的窗口" IsChecked="{Binding PasteOnSelect}"/>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="最多保留" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Text="{Binding MaxItems}"/>
                        <TextBlock Grid.Column="2" Text="条" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="保留天数" Style="{StaticResource Label}"/>
                        <TextBox Grid.Column="1" Text="{Binding MaxDays}"/>
                        <TextBlock Grid.Column="2" Text="天" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                               Text="历史只保存在本机数据目录的 history 文件夹。密码管理器等标记为“不记录”的内容会自动跳过。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="打开历史目录" Click="OpenHistoryFolder_Click"/>
                        <Button Content="清空历史" Margin="8,0,0,0" Click="ClearHistory_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
