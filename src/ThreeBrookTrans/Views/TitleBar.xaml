<!-- 自绘标题栏（三溪外观规范 §5）：高 36，左上 18 像素图标 + 标题（标题字体），右侧操作区 + 最小化 / 关闭 -->
<UserControl x:Class="ThreeBrookTrans.Views.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="40">
    <Grid Background="Transparent" MouseLeftButtonDown="Bar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="pack://application:,,,/ThreeBrookTrans;component/Assets/AppIcon-36.png" Width="18" Height="18"
               Margin="14,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
        <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource B.Text}"/>
        <ContentPresenter x:Name="Extra" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                          Content="{Binding TitleExtra, ElementName=Root}"/>
        <ContentPresenter Grid.Column="3" VerticalAlignment="Center" Content="{Binding Actions, ElementName=Root}"/>
        <Button x:Name="MinimizeButton" Grid.Column="4" Style="{StaticResource Btn.Icon}" Content="{StaticResource I.Minimize}"
                Width="36" FontSize="16" ToolTip="最小化" Visibility="Collapsed" Click="Minimize_Click"/>
        <Button Grid.Column="5" Style="{StaticResource Btn.TitleClose}" Content="{StaticResource I.Close}" Margin="2,0,8,0"
                ToolTip="{Binding CloseToolTip, ElementName=Root}" Click="Close_Click"/>
    </Grid>
</UserControl>
