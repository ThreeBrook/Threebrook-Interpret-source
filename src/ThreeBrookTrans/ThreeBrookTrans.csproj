<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- WindowsOcr 直接按 vtable 调用 WinRT 接口 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ThreeBrookTrans</AssemblyName>
    <RootNamespace>ThreeBrookTrans</RootNamespace>
    <Product>ThreeBrook Trans</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 应用通过 manifest 声明 PerMonitorV2，WinForms 的 DPI 建议不适用 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

</Project>
